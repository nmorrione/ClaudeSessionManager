<Window x:Class="ClaudeSessionManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Claude Session Manager" Width="1200" Height="720"
        WindowStartupLocation="CenterScreen" FontFamily="Segoe UI" FontSize="13"
        Loaded="Window_Loaded">
    <DockPanel>

        <!-- Barra di stato -->
        <Border DockPanel.Dock="Bottom" BorderBrush="#D0D0D0" BorderThickness="0,1,0,0" Padding="10,6" Background="#F7F7F7">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="260" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                <ProgressBar x:Name="Progress" Grid.Column="1" Height="14" Minimum="0" Maximum="100" />
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" Margin="8">

            <!-- ============================== ESPORTA ============================== -->
            <TabItem Header="  Esporta  ">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBox x:Name="FilterBox" Width="320" Padding="4,3" Margin="0,0,14,0"
                                 TextChanged="Filter_Changed" ToolTip="Filtra per titolo o cartella" />
                        <CheckBox x:Name="ShowArchived" Content="Mostra archiviate" IsChecked="True"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                        <CheckBox x:Name="ShowScratch" Content="Mostra sessioni senza cartella"
                                  Checked="Filter_Changed" Unchecked="Filter_Changed" />
                        <Button Content="Aggiorna" Click="Refresh_Click" />
                    </StackPanel>

                    <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" LastChildFill="False">
                        <Button Content="Seleziona tutte" Click="ExportSelectAll_Click" />
                        <Button Content="Deseleziona" Click="ExportSelectNone_Click" />
                        <TextBlock x:Name="SelectionText" VerticalAlignment="Center" Margin="8,0" Foreground="#555" />
                        <Button DockPanel.Dock="Right" Content="Esporta selezionate..." Click="Export_Click"
                                FontWeight="SemiBold" Margin="0" />
                        <CheckBox DockPanel.Dock="Right" x:Name="IncludeHistory" Content="Includi cronologia file (rewind)" />
                        <CheckBox DockPanel.Dock="Right" x:Name="IncludeMemory" Content="Includi memoria di progetto" IsChecked="True" />
                    </DockPanel>

                    <DataGrid x:Name="ExportGrid">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" Margin="0"
                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}"
                                                  IsEnabled="{Binding CanExport}" Click="ExportCheck_Click" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Titolo" Binding="{Binding Title}" Width="260" IsReadOnly="True" />
                            <DataGridTextColumn Header="Cartella progetto" Binding="{Binding Cwd}" Width="*" IsReadOnly="True" />
                            <DataGridTextColumn Header="Ultima attività" Binding="{Binding LastActivity, StringFormat=dd/MM/yyyy HH:mm}" Width="130" IsReadOnly="True" />
                            <DataGridTextColumn Header="MB" Binding="{Binding SizeMb, StringFormat=N1}" Width="70" IsReadOnly="True">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="HorizontalAlignment" Value="Right" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Account" Binding="{Binding Account}" Width="140" IsReadOnly="True" />
                            <DataGridTextColumn Header="Stato" Binding="{Binding State}" Width="140" IsReadOnly="True" />
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>

            <!-- ============================== IMPORTA ============================== -->
            <TabItem Header="  Importa  ">
                <DockPanel Margin="8">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                        <Button Content="Apri archivio..." Click="OpenArchive_Click" />
                        <TextBlock x:Name="ZipText" Text="Nessun archivio aperto." VerticalAlignment="Center" Margin="6,0" />
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBlock Text="Account dell'app di destinazione:" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <ComboBox x:Name="AccountBox" Width="480" SelectionChanged="Account_Changed" />
                        </StackPanel>
                        <DockPanel LastChildFill="False">
                            <Button Content="Seleziona tutte" Click="ImportSelectAll_Click" />
                            <Button Content="Deseleziona" Click="ImportSelectNone_Click" />
                            <Button Content="Scegli cartella per le righe evidenziate..." Click="BrowseTarget_Click" />
                            <Button x:Name="ImportButton" DockPanel.Dock="Right" Content="Importa selezionate"
                                    Click="Import_Click" IsEnabled="False" FontWeight="SemiBold" Margin="0" />
                        </DockPanel>
                    </StackPanel>

                    <DataGrid x:Name="ImportGrid" CellEditEnding="ImportGrid_CellEditEnding">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Width="36" CanUserSort="False">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <CheckBox HorizontalAlignment="Center" Margin="0"
                                                  IsChecked="{Binding IsSelected, UpdateSourceTrigger=PropertyChanged}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Titolo" Binding="{Binding Title}" Width="240" IsReadOnly="True" />
                            <DataGridTextColumn Header="Cartella originale" Binding="{Binding SourceCwd}" Width="260" IsReadOnly="True" />
                            <DataGridTextColumn Header="Cartella su questo PC (doppio clic per modificare)" Width="*"
                                                Binding="{Binding TargetCwd, UpdateSourceTrigger=LostFocus}" />
                            <DataGridTextColumn Header="Ultima attività" Binding="{Binding LastActivity, StringFormat=dd/MM/yyyy HH:mm}" Width="130" IsReadOnly="True" />
                            <DataGridTemplateColumn Header="Stato" Width="180" SortMemberPath="State">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding State}" Foreground="{Binding StateBrush}" VerticalAlignment="Center" Margin="4,0" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </DockPanel>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
